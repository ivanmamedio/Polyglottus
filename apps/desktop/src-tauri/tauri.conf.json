{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polyglottus",
  "version": "0.1.0",
  "identifier": "org.polyglottus.Polyglottus",
  "build": {
    "beforeBuildCommand": "npm run build --prefix ../../apps/desktop/ui",
    "beforeDevCommand": "npm run dev --prefix ../../apps/desktop/ui",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Polyglottus",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://localhost:11434 http://localhost:8080;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2024 Polyglottus Contributors",
    "category": "Utility",
    "shortDescription": "Tradutor de livros e documentos local-first",
    "longDescription": "Polyglottus traduz livros e documentos inteiros, preservando estrutura, imagens e layout.",
    "linux": {
      "deb": {
        "depends": ["webkit2gtk-4.1", "libayatana-appindicator3-1", "librsvg2-common"]
      }
    },
    "macOS": {
      "frameworks": ["WebKit"],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "dialog": {
      "all": true,
      "open": true,
      "save": true
    },
    "fs": {
      "all": true,
      "readFile": true,
      "writeFile": true,
      "readDir": true,
      "copyFile": true,
      "createDir": true,
      "removeDir": true,
      "removeFile": true,
      "renameFile": true
    },
    "shell": {
      "all": false,
      "open": true
    },
    "path": {
      "all": true
    },
    "window": {
      "all": false,
      "center": true,
      "requestUserAttention": true
    }
  }
}