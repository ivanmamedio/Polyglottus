<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" 
           Name="Polyglottus" 
           Language="1046" 
           Version="$(var.Version)" 
           Manufacturer="Polyglottus Contributors" 
           UpgradeCode="PUT-GUID-HERE">
    <Package InstallerVersion="500" 
             Compressed="yes" 
             InstallScope="perMachine" 
             Description="Polyglottus - Tradutor de livros e documentos local-first" 
             Manufacturer="Polyglottus Contributors" 
             Comments="https://github.com/polyglottus/polyglottus" />

    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente do Polyglottus já está instalada." />

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainProduct" Title="Polyglottus" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <UIRef Id="WixUI_Minimal" />

    <Icon Id="icon.ico" SourceFile="$(var.ProjectDir)icons/icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="icon.ico" />
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="Polyglottus" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Polyglottus" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="PUT-GUID-HERE">
        <File Id="polyglottus.exe" Source="$(var.BuildDir)polyglottus.exe" KeyPath="yes" />
      </Component>
      <!-- DLLs e recursos necessários -->
      <Component Id="WebView2Loader" Guid="PUT-GUID-HERE">
        <File Id="WebView2Loader.dll" Source="$(var.BuildDir)WebView2Loader.dll" KeyPath="yes" />
      </Component>
      <!-- Adicione outros arquivos necessários -->
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="PUT-GUID-HERE">
        <Shortcut Id="ApplicationStartMenuShortcut" 
                  Name="Polyglottus" 
                  Description="Tradutor de livros e documentos local-first" 
                  Target="[INSTALLFOLDER]polyglottus.exe" 
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Polyglottus" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="PUT-GUID-HERE">
        <Shortcut Id="ApplicationDesktopShortcut" 
                  Name="Polyglottus" 
                  Description="Tradutor de livros e documentos local-first" 
                  Target="[INSTALLFOLDER]polyglottus.exe" 
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Polyglottus" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>