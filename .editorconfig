root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{toml,json,yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.rs]
rustfmt_skip = false

[Makefile]
indent_style = tab

[*.{sh,bash,zsh}]
indent_style = space
indent_size = 4

[*.{js,ts,jsx,tsx,css,html}]
indent_size = 2